import CodedSorting.Generated.FiniteCircuit.ArrayLookup

/-! Concrete Construction certificate checks. Every success below is kernel checked.
Generated by certificates/generate_projection_checks.py. -/
namespace CodedSorting.Construction.FiniteCertificate
set_option Elab.async false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

def projectionAlgebraCheck (p : Projection) : Bool := Id.run do
  if p.denominator ≤ 0 || p.numerator.size != 64 || p.dimension > 8 then
    return false
  if !((List.range 8).all fun i => (List.range 8).all fun j =>
      matrixEntry p i j == matrixEntry p j i &&
      (List.range 8).foldl
        (fun a k => a + matrixEntry p i k * matrixEntry p k j) 0 ==
        p.denominator * matrixEntry p i j) then return false
  if (List.range 8).foldl (fun a i => a + matrixEntry p i i) 0 !=
      p.denominator * Int.ofNat p.dimension then return false
  return true

def projectionAlgebraValid (f : Nat) : Bool := projectionAlgebraCheck projections[f]!
end CodedSorting.Construction.FiniteCertificate
