private theorem recombine {α : Type} (xs tail : List α) (n : Nat) :
    xs.take n ++ (xs.drop n ++ tail) = xs ++ tail := by
  rw [← List.append_assoc, List.take_append_drop]

theorem gates_eq_segments : gates.toList = prefixChunks ++ scatterChunks ++ suffixChunks := by
  rw [gates_toList_chunks]
  simp only [prefixChunks, scatterChunks, suffixChunks, List.append_assoc, recombine]

