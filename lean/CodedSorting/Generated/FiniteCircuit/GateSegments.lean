theorem prefix_by_chunks : gates.toList.take beforeScatterCount = prefixChunks := by
  rw [gates_eq_segments, List.append_assoc]
  change (prefixChunks ++ (scatterChunks ++ suffixChunks)).take 2186 = prefixChunks
  rw [← prefixChunks_length, List.take_left]

theorem scatter_by_chunks : (gates.toList.drop beforeScatterCount).take portCount = scatterChunks := by
  rw [gates_eq_segments, List.append_assoc]
  change ((prefixChunks ++ (scatterChunks ++ suffixChunks)).drop 2186).take 111 = scatterChunks
  rw [← prefixChunks_length, List.drop_left, ← scatterChunks_length, List.take_left]

theorem suffix_by_chunks : gates.toList.drop (beforeScatterCount + portCount) = suffixChunks := by
  rw [gates_eq_segments, List.append_assoc]
  change (prefixChunks ++ (scatterChunks ++ suffixChunks)).drop (2186 + 111) = suffixChunks
  rw [← List.drop_drop, ← prefixChunks_length, List.drop_left, ← scatterChunks_length, List.drop_left]

