import Std

/-!
Concrete finite data for the 111-port Construction word.

All theorem proofs below use the kernel's `decide`, never `native_decide`.
The certificate records explicit scalar gates and integer matrices for all
636 orthogonal projections.  It does not by itself assert the tensor lift,
partial-swap implementation, network instance, or sorting theorem.

Generated by scripts/check_e8_certificate.py --emit-lean.
-/

namespace CodedSorting.Construction.FiniteCertificate

noncomputable section

set_option Elab.async false
set_option maxRecDepth 1000000
set_option maxHeartbeats 0

structure Gate where
  frame : Nat
  destination : Nat
  sources : List Nat
  deriving DecidableEq, Repr, Inhabited

structure Projection where
  denominator : Int
  dimension : Nat
  numerator : Array Int
  deriving DecidableEq, Repr, Inhabited

def portCount : Nat := 111
def helperCount : Nat := 439
def registerCount : Nat := 661
def scatterFrame : Nat := 636

def coefficientStart : Array Nat :=
  (List.range registerCount).toArray.map (fun r => 2 ^ r)

def coefficientExpected : Array Nat :=
  (List.range registerCount).toArray.map fun r =>
    if portCount ≤ r && r < 2 * portCount then
      Nat.xor (2 ^ r) (2 ^ (r - portCount))
    else 2 ^ r

def stepCoefficients (state : Array Nat) (g : Gate) : Array Nat :=
  state.set! g.destination
    (g.sources.foldl (fun a s => Nat.xor a state[s]!) state[g.destination]!)

def runCoefficients (program : Array Gate) : Array Nat :=
  program.foldl stepCoefficients coefficientStart


end
end CodedSorting.Construction.FiniteCertificate
